# Supabase — copy this file to `.env` and fill in your project's values.
# Get them from: Supabase Dashboard → Project Settings → API
#   Project URL  →  VITE_SUPABASE_URL
#   anon public  →  VITE_SUPABASE_ANON_KEY   (safe to expose; protected by RLS)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms — email notifications for form submissions
# Get your access key from: https://web3forms.com (free plan: 250 emails/month)
VITE_WEB3FORMS_KEY=

# Supabase service_role key — SERVER/CLI ONLY, never expose this in the browser.
# Only needed to WRITE blog articles with `npm run articles:push`.
# It bypasses Row Level Security completely, so treat it like a root password:
# keep it out of git, out of chat, and rotate it if it ever leaks.
# Get it from: Supabase Dashboard → Project Settings → API → service_role
# Note the missing VITE_ prefix — that is deliberate, it keeps Vite from
# inlining the key into the client bundle.
SUPABASE_SERVICE_KEY=

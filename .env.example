# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your project's values.
# Get them from: Supabase Dashboard → Project Settings → API Keys
# ═══════════════════════════════════════════════════════════════════════════

VITE_SUPABASE_URL=

# ─── Public / browser-safe key ────────────────────────────────────────────
# Supabase is replacing the legacy `anon` JWT with a "publishable" key.
# Set whichever your project uses — PUBLISHABLE takes priority if both are set.
# Both are safe to expose; your data is protected by Row Level Security.
#   New format:    Settings → API Keys → Publishable key   (sb_publishable_…)
#   Legacy format: Settings → API Keys → Legacy → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Web3Forms — email notifications for form submissions
# Get your access key from: https://web3forms.com (free plan: 250 emails/month)
VITE_WEB3FORMS_KEY=

# ─── Secret key — SERVER/CLI ONLY, never expose in the browser ─────────────
# Bypasses Row Level Security completely. Treat it like a root password:
# keep it out of git, out of chat, and revoke it if it ever leaks.
#   New format:    Settings → API Keys → Secret keys → Create  (sb_secret_…)
#   Legacy format: Settings → API Keys → Legacy → service_role
# Needed by: `npm run articles:push`, scripts/seed-coworking.mjs, etc.
# Note the missing VITE_ prefix — deliberate, it keeps Vite from inlining the
# key into the client bundle.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=

# ─── Admin Panel ──────────────────────────────────────────────────────────
# Nothing to configure here. Admins sign in with Supabase Auth (email +
# password) and their permissions are enforced by RLS policies in the database.
#
# Setup: run supabase/admin_setup_all_in_one.sql, then follow
# supabase/ADMIN_SETUP.md to create the first login.
#
# Roles and permissions are managed in the panel itself (Admin → Users & Access).
#
# There is deliberately no VITE_ADMIN_SERVICE_KEY any more: Supabase now rejects
# secret keys sent from a browser, and shipping one in the client bundle handed
# every visitor unrestricted database access.
